# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# LangSmith — optional tracing/monitoring for every graph.invoke() call. No code
# changes needed: all LLM calls already go through LangChain wrappers, so tracing
# is automatic once these are set. Get a key at smith.langchain.com > Settings > API Keys.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Optional: override the model each provider uses (falls back to config/*.yaml)
OPENAI_MODEL=
ANTHROPIC_MODEL=
PERPLEXITY_MODEL=
IMAGE_MODEL=       # default: gpt-image-1-mini (dall-e-3/dall-e-2 are discontinued)

# Research providers
SERPAPI_API_KEY=
PERPLEXITY_API_KEY=

# Session store — persists sessions/conversations so the sidebar dashboard can
# list and resume them. Default backend (config/*.yaml) is "postgres"; set
# SESSION_STORE_URL to a Postgres connection string. For Supabase, use the
# connection *pooler* string (Project Settings > Database > Connection String >
# "Transaction" or "Session" pooler mode) — the direct "db.<project>.supabase.co"
# host is IPv6-only and unreachable from many networks.
SESSION_STORE_URL=

# Optional overrides:
SESSION_STORE_BACKEND=   # postgres (default) | sqlite | memory (non-persistent, mainly for tests)
SESSION_STORE_PATH=      # only used when SESSION_STORE_BACKEND=sqlite; defaults to ./contentalchemy.db
SESSION_RETENTION_DAYS=  # days a deleted session stays recoverable from Trash before
                          # scripts/purge_deleted_sessions.py removes it for good; default 14

# Optional: override resilience defaults from config/services.yaml
MAX_RETRIES=
BACKOFF_SECONDS=
REVISION_LOOP_CAP=
RESEARCH_TOOL_ITERATIONS_CAP=
